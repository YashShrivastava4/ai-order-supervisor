GROQ_API_KEY=

# Postgres connection string. Leave unset for local dev — falls back to the
# docker-compose Postgres on port 5433. In production this is the Neon
# connection string (get it from your Neon project dashboard).
DATABASE_URL=

# Address of the Temporal server. Defaults to localhost:7233, which is
# correct in every environment we deploy to — the worker and API always
# run inside the same container. Only override this if you're running
# Temporal somewhere else.
TEMPORAL_ADDRESS=localhost:7233

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the local Next.js dev server. Add your deployed frontend's
# URL (e.g. https://your-app.vercel.app) once you have it.
FRONTEND_ORIGINS=http://localhost:3000
