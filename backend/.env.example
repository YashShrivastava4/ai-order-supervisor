# Postgres — matches docker-compose.yml
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/order_supervisor

# Temporal dev server (started via `temporal server start-dev`)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-supervisor-task-queue

# LLM — leave GROQ_API_KEY blank and USE_MOCK_LLM=true to demo with zero API key
# Get a free key (no credit card required) at https://console.groq.com/keys
GROQ_API_KEY=
USE_MOCK_LLM=true
