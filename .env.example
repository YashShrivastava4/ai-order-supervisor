# Base URL the Next.js frontend uses to reach the FastAPI backend.
# Locally this defaults to http://localhost:8000 if unset (see src/lib/api.ts).
# In production, set this to your deployed backend's URL, no trailing slash
# (e.g. https://order-supervisor-backend-mrpj.onrender.com) — a trailing
# slash here produces double-slash request URLs like POST //api/supervisors,
# which fails with "Failed to fetch". src/lib/api.ts strips a trailing slash
# defensively, but it's still cleanest to paste the URL in without one.
NEXT_PUBLIC_API_URL=http://localhost:8000
