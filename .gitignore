.vercel

# --- Backend (Python) ---
backend/.venv/
backend/**/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
backend/.pytest_cache/
backend/*.egg-info/

# --- Temporal ---
# Local dev server database file created by
# `temporal server start-dev --db-filename temporaldata`.
# This is a runtime artifact, not source code — never commit it.
temporaldata
temporaldata-journal
*.db

# --- Env files ---
.env
.env.*
!.env.example
backend/.env
!backend/.env.example

